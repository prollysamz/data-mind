# LLM Configuration (OpenAI-compatible endpoint: Bedrock Mantle, Ollama, vLLM, etc.)
LLM_BASE_URL=
LLM_API_KEY=
LLM_ORCHESTRATOR_MODEL=
LLM_REASONING_MODEL=
LLM_FAST_MODEL=

# Amazon Bedrock Mantle (select Bedrock Mantle in Settings)
BEDROCK_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/openai/v1
AWS_REGION=us-east-1
BEDROCK_MODEL=google.gemma-4-26b-a4b
BEDROCK_MANTLE_ROUTE=/openai/v1
# Optional financial ceiling; set both official model prices when enabling it
DATAMIND_BUDGET_MAX_USD=
DATAMIND_PRICE_INPUT_M=
DATAMIND_PRICE_OUTPUT_M=

# Snowflake Configuration
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Optional separate ingestion login; grant it DATAMIND_LOADER using the bootstrap SQL.
# Without these, the configured Snowflake login must also hold DATAMIND_LOADER.
SNOWFLAKE_LOADER_USER=
SNOWFLAKE_LOADER_PASSWORD=
